<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".view.EscolheActivity">


    <!-- ================================================= -->
    <!-- CABEÇALHO VERDE -->
    <!-- ================================================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="240dp"
        app:cardBackgroundColor="#55945F"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <!-- ========================================= -->
            <!-- LOGO -->
            <!-- ========================================= -->

            <ImageView
                android:id="@+id/logo"
                android:layout_width="85dp"
                android:layout_height="90dp"
                android:layout_marginTop="40dp"
                android:contentDescription="Logo Renovai"
                android:scaleType="fitCenter"
                android:src="@drawable/logo"
                app:layout_constraintBottom_toTopOf="@id/renovaiEstilizado"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />


            <!-- ========================================= -->
            <!-- RENOVAI -->
            <!-- ========================================= -->

            <ImageView
                android:id="@+id/renovaiEstilizado"
                android:layout_width="235dp"
                android:layout_height="58dp"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="5dp"
                android:contentDescription="Renovai"
                android:scaleType="fitCenter"
                android:src="@drawable/renovai_estilizado"
                app:layout_constraintBottom_toTopOf="@id/transformeTexto"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/logo" />


            <!-- ========================================= -->
            <!-- SLOGAN -->
            <!-- ========================================= -->

            <ImageView
                android:id="@+id/transformeTexto"
                android:layout_width="190dp"
                android:layout_height="20dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="Transforme hoje, sustente o amanhã"
                android:scaleType="fitCenter"
                android:src="@drawable/transforme_texto"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/renovaiEstilizado" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ================================================= -->
    <!-- TAMPA CANTO SUPERIOR ESQUERDO -->
    <!-- ================================================= -->

    <View
        android:id="@+id/tampaSuperiorEsquerda"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="#55945F"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="@id/header"
        app:layout_constraintStart_toStartOf="@id/header" />


    <!-- ================================================= -->
    <!-- TAMPA CANTO SUPERIOR DIREITO -->
    <!-- ================================================= -->

    <View
        android:id="@+id/tampaSuperiorDireita"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="#55945F"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="@id/header"
        app:layout_constraintEnd_toEndOf="@id/header" />


    <!-- ================================================= -->
    <!-- BOTÃO VOLTAR -->
    <!-- ================================================= -->

    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="45dp"
        android:clickable="true"
        android:contentDescription="Voltar"
        android:elevation="3dp"
        android:focusable="true"
        android:scaleType="fitCenter"
        android:src="@drawable/voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ================================================= -->
    <!-- TÍTULO -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="31dp"
        android:text="Escolha um perfil"
        android:textColor="#111111"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />


    <!-- ================================================= -->
    <!-- CARD COOPERATIVA -->
    <!-- ================================================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCooperativa"
        android:layout_width="0dp"
        android:layout_height="134dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="31dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#55945F"
        app:cardCornerRadius="13dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/titulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cooperativaButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <!-- ÍCONE COOPERATIVA -->


            <!-- TÍTULO -->

            <ImageView
                android:id="@+id/iconeCooperativa"
                android:layout_width="43dp"
                android:layout_height="43dp"
                android:layout_marginTop="16dp"
                android:contentDescription="Cooperativa"
                android:scaleType="fitCenter"
                android:src="@drawable/cooperativa"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/descricaoCooperativa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="15dp"
                android:gravity="center"
                android:text="Participe da sua cooperativa, equipe e materiais"
                android:textColor="#BFD2C1"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tituloCooperativa" />

            <TextView
                android:id="@+id/tituloCooperativa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cooperativa"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconeCooperativa" />


            <!-- DESCRIÇÃO -->

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ================================================= -->
    <!-- CARD EMPRESA -->
    <!-- ================================================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEmpresa"
        android:layout_width="0dp"
        android:layout_height="134dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="17dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#922B56"
        app:cardCornerRadius="13dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardCooperativa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/empresaButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <!-- ÍCONE EMPRESA -->


            <!-- TÍTULO -->

            <ImageView
                android:id="@+id/iconeEmpresa"
                android:layout_width="43dp"
                android:layout_height="43dp"
                android:layout_marginTop="16dp"
                android:contentDescription="Empresa"
                android:scaleType="fitCenter"
                android:src="@drawable/empresa"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/descricaoEmpresa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="15dp"
                android:gravity="center"
                android:text="Encontre materiais recicláveis e negocie com cooperativas"
                android:textColor="#D3B2C0"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tituloEmpresa" />

            <TextView
                android:id="@+id/tituloEmpresa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Empresa"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.501"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconeEmpresa" />


            <!-- DESCRIÇÃO -->

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>