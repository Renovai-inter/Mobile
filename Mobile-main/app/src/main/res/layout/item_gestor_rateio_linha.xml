<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
        <CheckBox android:id="@+id/chkParticipa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="#519059" android:minWidth="0dp" android:minHeight="0dp" />
        <TextView android:id="@+id/txtRateioNome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1"
            android:text="Nome" android:textColor="#111111" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <EditText android:id="@+id/edtPercentual" android:layout_width="62dp" android:layout_height="34dp" android:background="@drawable/input_field_cooperado_background"
            android:gravity="center" android:hint="%" android:inputType="numberDecimal" android:padding="2dp" android:textColor="#4A5568" android:textSize="12sp" />
        <TextView android:id="@+id/txtRateioValorLinha" android:layout_width="86dp" android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:gravity="end" android:text="-" android:textColor="#111111" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D8D8D8" />
</LinearLayout>
