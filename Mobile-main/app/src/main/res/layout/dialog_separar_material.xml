<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="4dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Material"
        android:textColor="#8A8A8A"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/txtNomeMaterialDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="—"
        android:textColor="#222222"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Peso separado (kg)"
        android:textColor="#222222"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtPesoSeparado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/input_field_cooperado_background"
        android:hint="Ex: 13"
        android:inputType="numberDecimal"
        android:padding="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Peso rejeitado (kg) — opcional"
        android:textColor="#222222"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtPesoRejeitado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/input_field_cooperado_background"
        android:hint="Ex: 1"
        android:inputType="numberDecimal"
        android:padding="12dp" />

</LinearLayout>
