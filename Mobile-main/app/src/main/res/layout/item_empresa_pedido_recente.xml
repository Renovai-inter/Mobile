<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardPedidoRecente" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
    android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
    <View android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/photo_placeholder_cooperado_background" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Material" android:textColor="#111111" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtPedidoRecenteSub" style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cooperativa tal — 50kg" android:textSize="11sp" />
        <TextView android:id="@+id/txtPedidoRecenteData" style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hoje, 10:45" android:textSize="10sp" />
    </LinearLayout>
    <TextView android:id="@+id/txtPedidoRecenteBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="Em Negociação" android:textSize="10sp" android:textStyle="bold" />
</LinearLayout>
