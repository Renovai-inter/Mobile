rules_version = '2';
// Regras do Firebase Storage do Renovaí — cole em: Console Firebase > Storage > Regras
service firebase.storage {
  match /b/{bucket}/o {

    // Relatórios PDF da cooperativa (GestorRelatorios): relatorios/{cooperativaId}/{id}.pdf
    match /relatorios/{cooperativaId}/{arquivo} {
      allow read, delete: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /{todo=**} {
      allow read, write: if false;
    }
  }
}
