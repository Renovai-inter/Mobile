rules_version = '2';
// Regras do Firestore do Renovaí — cole em: Console Firebase > Firestore Database > Regras
service cloud.firestore {
  match /databases/{database}/documents {

    // Cache offline das listagens (FirebaseCache): cada instalação do app
    // (usuário anônimo do Firebase) só lê e grava o próprio cache.
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Lista de relatórios PDF da cooperativa (GestorRelatorios).
    match /cooperativas/{cooperativaId}/relatorios/{relatorioId} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.url is string
        && request.resource.data.nome is string;
    }

    // Descrição e data prevista da triagem de cada coleta (ColetaDetalhes): o banco da API não
    // tem esses campos. Só texto curto e data no formato aaaa-mm-dd.
    match /cooperativas/{cooperativaId}/coletas/{coletaId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['descricao', 'dataPrevistaTriagem', 'criadoPor', 'atualizadoEm'])
        && (!('descricao' in request.resource.data)
            || (request.resource.data.descricao is string && request.resource.data.descricao.size() <= 500))
        && (!('dataPrevistaTriagem' in request.resource.data)
            || request.resource.data.dataPrevistaTriagem.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    // Aparelhos das notificações push (dispositivos_push): só a API grava e lê, pelo SDK de
    // admin, que não passa por estas regras. Para o app a coleção fica fechada (regra abaixo).

    // Todo o resto fica fechado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
