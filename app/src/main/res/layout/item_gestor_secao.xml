<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp"
    android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/txtSecaoTitulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="ATIVOS" android:textColor="#519059" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/txtSecaoContador" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
        android:background="@drawable/pill_light_green" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="1dp" android:paddingBottom="1dp"
        android:text="0" android:textColor="#3F6B3F" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
