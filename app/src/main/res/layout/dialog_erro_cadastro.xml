<?xml version="1.0" encoding="utf-8"?>
<!--
    Pop-up de erro do cadastro (CadastroActivity), no formato do pop-up padrão: título vinho em
    negrito, texto cinza e os botões à direita (o principal cheio, o secundário só texto). O cartão
    branco com cantos arredondados vem do tema (ThemeOverlay.Renovai.Dialogo).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <!-- O código ainda escolhe o ícone por tipo de erro; o pop-up padrão não mostra ícone. -->
    <ImageView
        android:id="@+id/imgErro"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtTituloErro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/vinho"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtMensagemErro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/popup_texto"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/txtDicaErro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/popup_dica_background"
        android:padding="12dp"
        android:textColor="#3D6E43"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSecundarioErro"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/vinho"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnPrimarioErro"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/popup_botao"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/txtPrimarioErro"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</LinearLayout>
