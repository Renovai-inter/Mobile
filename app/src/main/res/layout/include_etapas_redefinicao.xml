<?xml version="1.0" encoding="utf-8"?>
<!--
  Indicador das 3 etapas da redefinição de senha (verificação em dois fatores):
  1 E-mail (1º fator) → 2 Código enviado por e-mail (2º fator) → 3 Nova senha.
  A Activity marca a etapa atual com EtapasRedefinicao.marcar(activity, etapa).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/etapasRedefinicao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="30dp"
    android:layout_marginEnd="30dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/etapa1"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_etapa_pendente"
            android:gravity="center"
            android:text="1"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/etapa1Texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="E-mail"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:id="@+id/etapaLinha1"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="18dp"
        android:layout_weight="1"
        android:background="#D1D5DB" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/etapa2"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_etapa_pendente"
            android:gravity="center"
            android:text="2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/etapa2Texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Código"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:id="@+id/etapaLinha2"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="18dp"
        android:layout_weight="1"
        android:background="#D1D5DB" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/etapa3"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_etapa_pendente"
            android:gravity="center"
            android:text="3"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/etapa3Texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Nova senha"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
