<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_light_cooperado" android:orientation="vertical">

    <include layout="@layout/include_gestor_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <TextView style="@style/G.Section" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Visão Geral:" android:textStyle="normal" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="horizontal">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginEnd="6dp" android:background="@drawable/kpi_card_background"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Pedidos Pendentes" android:textColor="#882B4E" android:textSize="14sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/txtKpiPedidos" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="00" android:textColor="#882B4E" android:textSize="30sp" android:textStyle="bold" />
                        <TextView android:id="@+id/txtKpiPedidosDet" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:text="0 Abertos\n0 Em negociação" android:textColor="#882B4E" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="6dp" android:background="@drawable/kpi_card_background"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Coletas no mês" android:textColor="#882B4E" android:textSize="14sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/txtKpiColetas" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="00" android:textColor="#882B4E" android:textSize="30sp" android:textStyle="bold" />
                        <TextView android:id="@+id/txtKpiColetasDet" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:text="0 Externas\n0 Internas" android:textColor="#882B4E" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/kpi_card_background"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Estoque Total (em Kg)" android:textColor="#882B4E" android:textSize="14sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/txtKpiEstoque" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="#882B4E" android:textSize="38sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txtKpiEstoqueDet" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:text="0kg Triados\n0kg Em transito" android:textColor="#882B4E" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/G.Section" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:text="Ações Rápidas" android:textStyle="normal" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="horizontal">
                <LinearLayout android:id="@+id/btnNovaTriagem" android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1"
                    android:layout_marginEnd="6dp" android:background="@drawable/card_maroon_background" android:clickable="true" android:focusable="true"
                    android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_upload_white" android:contentDescription="Nova triagem" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                        android:text="Nova triagem" android:textColor="#FFFFFF" android:textSize="14sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/btnNovaRota" android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1"
                    android:layout_marginStart="6dp" android:background="@drawable/card_maroon_background" android:clickable="true" android:focusable="true"
                    android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_add_circle_white" android:contentDescription="Nova rota" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                        android:text="Nova rota" android:textColor="#FFFFFF" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="horizontal">
                <LinearLayout android:id="@+id/btnNovoRateio" android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1"
                    android:layout_marginEnd="6dp" android:background="@drawable/card_maroon_background" android:clickable="true" android:focusable="true"
                    android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_rateio_white" android:contentDescription="Novo rateio" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                        android:text="Novo rateio" android:textColor="#FFFFFF" android:textSize="14sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/btnPedidos" android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1"
                    android:layout_marginStart="6dp" android:background="@drawable/card_maroon_background" android:clickable="true" android:focusable="true"
                    android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_cart_white" android:contentDescription="Pedidos" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                        android:text="Pedidos" android:textColor="#FFFFFF" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:orientation="horizontal">
                <TextView android:id="@+id/txtAtalhoRotas" style="@style/G.Green" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="Ver rotas" />
                <TextView android:id="@+id/txtAtalhoRelatorios" style="@style/G.Green" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="28dp" android:padding="8dp" android:text="Meus relatórios" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal">
                <TextView style="@style/G.Section" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Pedidos Pendentes:" android:textStyle="normal" />
                <TextView android:id="@+id/txtVerTodosPedidos" style="@style/G.Green" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ver todos" />
            </LinearLayout>
            <TextView android:id="@+id/txtSemPedidos" style="@style/G.Sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="Nenhum pedido pendente." android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerHomePedidos" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp" android:nestedScrollingEnabled="false" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                <TextView style="@style/G.Section" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Coletas recentes:" android:textStyle="normal" />
                <TextView android:id="@+id/txtVerTodasColetas" style="@style/G.Green" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ver todas" />
            </LinearLayout>
            <TextView android:id="@+id/txtSemColetas" style="@style/G.Sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="Nenhuma coleta registrada." android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerHomeColetas" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp" android:nestedScrollingEnabled="false" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                <TextView style="@style/G.Section" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Triagens recentes:" android:textStyle="normal" />
                <TextView android:id="@+id/txtVerTodasTriagens" style="@style/G.Green" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ver todas" />
            </LinearLayout>
            <TextView android:id="@+id/txtSemTriagens" style="@style/G.Sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="Nenhuma triagem registrada." android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerHomeTriagens" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp" android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/include_gestor_nav" />
</LinearLayout>
