<?xml version="1.0" encoding="utf-8"?>
<!-- Mapa da rota em andamento: posição do motorista, paradas em ordem e a próxima coleta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_light_cooperado" android:orientation="vertical">
    <include layout="@layout/include_gestor_topbar" />

    <TextView android:id="@+id/txtAvisoMapaNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="10dp" android:layout_marginEnd="16dp" android:background="@drawable/status_card_cooperado_background" android:padding="10dp" android:text="—" android:textColor="#882B4E" android:textSize="12sp" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <FrameLayout android:id="@+id/containerMapaNav" android:layout_width="match_parent" android:layout_height="match_parent" />
        <com.example.renovai.view.RotaMapView android:id="@+id/mapaEsquemaNav" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="16dp" android:visibility="gone" />
        <TextView android:id="@+id/btnCentralizarNav" style="@style/G.BtnFilled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="12dp" android:contentDescription="Centralizar no trajeto" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Ver trajeto" android:textSize="12sp" />
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/status_card_cooperado_background" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/txtProgressoNav" style="@style/G.Sub" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="13sp" />
            <TextView android:id="@+id/btnParadasNav" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp" android:text="Ver paradas" android:textColor="#519059" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar android:id="@+id/barraProgressoNav" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:max="100" android:progressTint="#519059" />

        <TextView android:id="@+id/txtProximaRotuloNav" style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Próxima parada" android:textSize="12sp" />
        <TextView android:id="@+id/txtProximaEnderecoNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#111111" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtProximaDistNav" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="" android:textColor="#882B4E" android:textSize="13sp" />

        <LinearLayout android:id="@+id/boxAcoesNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <TextView android:id="@+id/btnNavegarNav" style="@style/G.BtnOutline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:text="Navegar" />
            <TextView android:id="@+id/btnConcluirNav" style="@style/G.BtnFilled" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Concluir parada" />
        </LinearLayout>
        <TextView android:id="@+id/btnIniciarNav" style="@style/G.BtnFilled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Iniciar Rota" android:visibility="gone" />
        <TextView android:id="@+id/btnFinalizarNav" style="@style/G.BtnOutline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Finalizar Rota" android:textColor="#882B4E" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
