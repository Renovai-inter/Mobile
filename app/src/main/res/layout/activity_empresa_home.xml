<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_light_cooperado" android:orientation="vertical">

    <include layout="@layout/include_empresa_header" />

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <TextView style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Visão Geral:" android:textSize="14sp" android:textColor="#222222" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:background="@drawable/status_card_cooperado_background" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pedidos enviados" android:textSize="13sp" />
                        <TextView android:id="@+id/txtPedidosMes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#882B4E" android:textSize="30sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:orientation="horizontal" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:id="@+id/txtEmNegociacao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#882B4E" android:textSize="15sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Aceitos" android:textColor="#6B7280" android:textSize="12sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:id="@+id/txtFinalizados" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#519059" android:textSize="15sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Valor negociado" android:textColor="#6B7280" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cooperativas favoritadas" android:layout_marginTop="12dp" />
            <TextView android:id="@+id/txtTotalFavoritasE" style="@style/G.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" />
            <TextView android:id="@+id/btnBuscarMateriaisE" style="@style/G.BtnFilled" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Buscar Materiais" android:layout_marginTop="12dp" />
            <TextView android:id="@+id/btnMeusPedidosE" style="@style/G.BtnOutline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Meus Pedidos" android:layout_marginTop="8dp" />
            <TextView style="@style/G.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Pedidos Recentes" />
            <LinearLayout android:id="@+id/listaPedidosRecentes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
            <TextView android:id="@+id/txtSemPedidos" style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nenhum pedido enviado ainda." />

            <TextView style="@style/G.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Cooperativas Favoritas" />
            <LinearLayout android:id="@+id/linhaCooperativasRecentes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" />
            <TextView android:id="@+id/txtSemFavoritas" style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Você ainda não tem cooperativas favoritas." />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/include_empresa_nav" />
</LinearLayout>
