<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_light_cooperado" android:orientation="vertical">
    <include layout="@layout/include_gestor_topbar" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:id="@+id/cardNegociacoes" android:layout_width="0dp" android:layout_height="170dp" android:layout_weight="1" android:layout_marginEnd="8dp"
                    android:background="@drawable/card_selected_background" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:padding="12dp">
                    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_refresh_cooperado" android:contentDescription="Negociações" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Negociações" android:textColor="#4A1B2E" android:textSize="15sp" android:textStyle="bold" />
                    <TextView style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Conversão de pedidos por período" />
                </LinearLayout>
                <LinearLayout android:id="@+id/cardImpacto" android:layout_width="0dp" android:layout_height="170dp" android:layout_weight="1" android:layout_marginStart="8dp"
                    android:background="@drawable/card_unselected_background" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:padding="12dp">
                    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_check_circle_cooperado" android:contentDescription="Impacto" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Impacto\nAmbiental" android:textColor="#4A1B2E" android:textSize="15sp" android:textStyle="bold" />
                    <TextView style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="CO2, energia e água economizadas" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/G.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Período de análise" android:textSize="16sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <LinearLayout android:id="@+id/boxInicio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp"
                    android:background="@drawable/card_unselected_background" android:clickable="true" android:focusable="true" android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="INICIO" android:textColor="#6B7280" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txtInicio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Selecionar" android:textColor="#111111" android:textSize="17sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/boxFim" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
                    android:background="@drawable/card_unselected_background" android:clickable="true" android:focusable="true" android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FIM" android:textColor="#6B7280" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txtFim" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Selecionar" android:textColor="#A0A4AB" android:textSize="17sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/G.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginStart="4dp" android:text="Nome (opcional)" android:textSize="15sp" />
            <EditText android:id="@+id/edtNomeRelatorio" style="@style/G.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:hint="Nome do relatório" android:inputType="textCapSentences" />

            <TextView android:id="@+id/btnCriarRelatorio" style="@style/G.BtnFilled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="60dp" android:text="Criar relatório" />
            <TextView android:id="@+id/btnCancelar" style="@style/G.BtnOutline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Cancelar" android:textColor="#111111" />
            <ProgressBar android:id="@+id/progresso" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="12dp" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include layout="@layout/include_gestor_nav" />
</LinearLayout>
