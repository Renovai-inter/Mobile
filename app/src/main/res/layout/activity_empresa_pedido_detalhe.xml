<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_light_cooperado" android:orientation="vertical">
    <include layout="@layout/include_empresa_topbar" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout style="@style/G.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/txtPedidoTituloE" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pedido #000000" android:textColor="#111111" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txtPedidoStatusE" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:text="Em Negociação" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/txtPedidoIniciadoE" style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Iniciado em --" android:textSize="13sp" />

                <TextView style="@style/G.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="COOPERATIVA" android:textStyle="normal" />
                <TextView android:id="@+id/txtPedidoCoopE" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#882B4E" android:textSize="14sp" />

                <TextView style="@style/G.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="MATERIAIS" android:textStyle="normal" />
                <LinearLayout android:id="@+id/listaItensPedidoE" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />

                <LinearLayout android:id="@+id/boxContrapropostaE" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/status_card_cooperado_background" android:visibility="gone">
                    <TextView android:id="@+id/txtValorContrapropostaE" style="@style/G.Value" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/txtObservacaoContrapropostaE" style="@style/G.Sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#222222" />
                </LinearLayout>
                <TextView android:id="@+id/txtConfirmacaoAceiteE" style="@style/G.Sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="#2E7D32" android:visibility="gone" />

                <TextView style="@style/G.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="ENDEREÇO DA COOPERATIVA" android:textStyle="normal" />
                <TextView android:id="@+id/txtPedidoEnderecoE" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Não informado" android:textColor="#111111" android:textSize="14sp" />

                <TextView style="@style/G.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="CONTATO DA COOPERATIVA" android:textStyle="normal" />
                <TextView android:id="@+id/txtPedidoComplementoE" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nenhum" android:textColor="#111111" android:textSize="14sp" />

                <TextView style="@style/G.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="VALOR DO PEDIDO / CONTRAPROPOSTA" android:textStyle="normal" />
                <TextView android:id="@+id/txtPedidoTotalE" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 0,00" android:textColor="#882B4E" android:textSize="26sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView android:id="@+id/btnConversarE" style="@style/G.BtnFilled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Conversar com a cooperativa" />
            <LinearLayout android:id="@+id/boxAcoesPedidoE" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:visibility="gone">
                <TextView android:id="@+id/btnRecusarE" style="@style/G.BtnOutline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="Recusar" android:textColor="#222222" />
                <TextView android:id="@+id/btnAceitarValorE" style="@style/G.BtnFilled" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Aceitar Valor" />
            </LinearLayout>
            <ProgressBar android:id="@+id/progressoE" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="10dp" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
