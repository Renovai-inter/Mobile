<?xml version="1.0" encoding="utf-8"?>
<!-- Tela 1.7 — Esqueci minha senha (etapa 1 de 3: e-mail) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAF8"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".view.EsqueciSenhaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="30dp">

        <FrameLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardBackgroundColor="#519059"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="78dp"
                    android:layout_height="82dp"
                    android:layout_gravity="center"
                    android:contentDescription="Logo Renovaí"
                    android:src="@drawable/logo" />
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="top|start"
                android:background="#519059" />

            <View
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="top|end"
                android:background="#519059" />

            <ImageView
                android:id="@+id/btnVoltar"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="20dp"
                android:layout_marginTop="45dp"
                android:contentDescription="Voltar"
                android:src="@drawable/voltar" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:text="Esqueci minha senha"
            android:textColor="#000000"
            android:textSize="20sp" />

        <include layout="@layout/include_etapas_redefinicao" />

        <TextView
            android:id="@+id/txtInstrucao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="22dp"
            android:gravity="center"
            android:text="Informe o e-mail da sua conta. Para confirmar que é você, vamos enviar um código de 6 dígitos para esse e-mail."
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="35dp"
            android:layout_marginBottom="7dp"
            android:text="E-mail"
            android:textColor="#000000"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/campoEmail"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:background="#F8F8F8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="15dp"
                android:contentDescription="E-mail"
                android:src="@drawable/email_icon" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Digite seu e-mail"
                android:inputType="textEmailAddress"
                android:textColor="#000000"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnEnviar"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#882B4E"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Enviar código"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <ProgressBar
            android:id="@+id/progressoEsqueci"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
