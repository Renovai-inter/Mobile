<?xml version="1.0" encoding="utf-8"?>
<!-- Material disponível na cooperativa: foto, nome com as especificações ao lado e o peso em estoque. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"
    android:background="@drawable/card_unselected_background" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/imgEstoqueLinha" android:layout_width="48dp" android:layout_height="48dp"
        android:background="@drawable/photo_placeholder_cooperado_background" android:contentDescription="Foto do material" android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/Renovai.FotoArredondada" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="8dp"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/txtEstoqueLinhaNome" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Material" android:textColor="#111111" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtEstoqueLinhaDetalhes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp" android:textColor="@color/popup_texto" android:textSize="12sp" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/txtEstoqueLinhaKg" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/pill_light_green" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:text="0 kg" android:textColor="#3F6B3F" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
