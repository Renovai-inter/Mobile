<?xml version="1.0" encoding="utf-8"?>
<!-- Cadastrar material da cooperativa: categoria, foto, preço sugerido e disponibilidade. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light_cooperado">

    <LinearLayout
        android:id="@+id/headerAdicionarMaterial"
        android:tag="topo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/header_cooperado_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnVoltarAdicionarMaterial"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/voltar"
            android:contentDescription="Voltar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="40dp"
            android:gravity="center"
            android:text="Cadastrar Material"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerAdicionarMaterial">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Categoria do material"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerCategoriaNovoMaterial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_field_cooperado_background"
                android:padding="12dp" />

            <TextView
                android:id="@+id/txtCategoriaPai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#8A8A8A"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Foto do material"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="6dp">

                <ImageView
                    android:id="@+id/imgPreviewFotoMaterial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/photo_placeholder_cooperado_background"
                    android:contentDescription="Foto do material"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtSemFotoMaterial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/photo_placeholder_cooperado_background"
                    android:gravity="center"
                    android:text="Nenhuma foto anexada"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnexarFotoMaterial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/outline_button_cooperado_background"
                app:backgroundTint="@null"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Anexar foto do material"
                android:textAllCaps="false"
                android:textColor="#882B4E"
                app:icon="@drawable/ic_camera_cooperado"
                app:iconGravity="textStart"
                app:iconTint="#882B4E" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Preço sugerido por kg (opcional)"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtPrecoMaterial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_field_cooperado_background"
                android:hint="Ex: 2,50"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textColor="#222222"
                android:textColorHint="#AAAAAA"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/input_field_cooperado_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Disponível para venda"
                        android:textColor="#222222"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="As empresas veem o material na busca"
                        android:textColor="#8A8A8A"
                        android:textSize="11sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchMaterialDisponivel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="@color/vinho"
                    android:trackTint="#E3C3CF" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCadastrarMaterial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/filled_button_cooperado_background"
                app:backgroundTint="@null"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="Cadastrar material"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:icon="@drawable/ic_send"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF" />

            <ProgressBar
                android:id="@+id/progressCadastrarMaterial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
