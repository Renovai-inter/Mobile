<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_light_cooperado" android:orientation="vertical">
    <include layout="@layout/include_empresa_topbar" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <FrameLayout android:layout_width="46dp" android:layout_height="46dp">
                    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/avatar_maroon_background" />
                    <TextView android:id="@+id/txtIniciaisCoopPedido" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="--" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/txtNomeCoopPedido" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nome da cooperativa" android:textColor="#111111" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txtContatoCoopPedido" style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Contato não informado" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/G.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Tipo de Material" android:textSize="15sp" />
            <LinearLayout android:id="@+id/campoMaterial" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:background="@drawable/input_field_cooperado_background" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                <TextView android:id="@+id/txtMaterialSel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Selecionar material" android:textColor="#8A8A8A" android:textSize="14sp" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_dark" android:rotation="90" android:contentDescription="Selecionar" />
            </LinearLayout>

            <TextView style="@style/G.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Peso" android:textSize="15sp" />
            <EditText android:id="@+id/edtPesoPedido" style="@style/G.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Ex: 10 kg" android:inputType="numberDecimal" />

            <TextView style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Valor proposto por kg" android:textColor="#222222" android:textSize="14sp" />
            <EditText android:id="@+id/edtPrecoProposto" style="@style/G.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ex.: 2,50" android:inputType="numberDecimal" />
            <TextView android:id="@+id/txtPrecoKgPedido" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 0,00" android:textColor="#882B4E" android:textSize="20sp" android:textStyle="bold" />

            <TextView style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Preço Total estimado" android:textColor="#222222" android:textSize="14sp" />
            <TextView android:id="@+id/txtPrecoTotalPedido" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 0,00" android:textColor="#882B4E" android:textSize="26sp" android:textStyle="bold" />

            <LinearLayout android:id="@+id/listaCarrinho" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" />

            <TextView style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:gravity="center"
                android:text="Ao adicionar ao carrinho você pode solicitar outros materiais para a mesma cooperativa" />

            <TextView android:id="@+id/btnAdicionarCarrinho" style="@style/G.BtnOutline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Adicionar ao carrinho" />
            <TextView android:id="@+id/btnFinalizarPedido" style="@style/G.BtnFilled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Finalizar pedido" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
