<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_light_cooperado" android:orientation="vertical">
    <include layout="@layout/include_motorista_header" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView style="@style/G.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rotas da cooperativa" />

            <TextView style="@style/G.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Em andamento" />
            <LinearLayout android:id="@+id/listaAndamento" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
            <TextView android:id="@+id/txtSemAndamento" style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Acompanhamento da viagem disponível em breve." />

            <TextView style="@style/G.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Disponíveis" />
            <LinearLayout android:id="@+id/listaAgendadas" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
            <TextView android:id="@+id/txtSemAgendadas" style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nenhuma rota disponível." />

            <TextView style="@style/G.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Rotas inativas" />
            <LinearLayout android:id="@+id/listaConcluidas" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
            <TextView android:id="@+id/txtSemConcluidas" style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nenhuma rota inativa." />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include layout="@layout/include_motorista_nav" />
</LinearLayout>
