<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRotaM" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"
    android:background="@drawable/status_card_cooperado_background" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/txtRotaMNome" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Rota" android:textColor="#111111" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/txtRotaMSub" style="@style/G.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/txtRotaMBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="Em Rota" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
        <View android:layout_width="9dp" android:layout_height="9dp" android:background="@drawable/avatar_green_background" />
        <TextView android:id="@+id/txtRotaMOrigem" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Origem" android:textColor="#222222" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:text="→" android:textColor="#888888" />
        <View android:layout_width="9dp" android:layout_height="9dp" android:background="@drawable/avatar_maroon_background" />
        <TextView android:id="@+id/txtRotaMDestino" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Destino" android:textColor="#222222" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:id="@+id/txtRotaMResumo" style="@style/G.Sub" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0 paradas" android:textSize="12sp" />
        <TextView android:id="@+id/txtRotaMProgresso" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#519059" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>
    <ProgressBar android:id="@+id/barRotaM" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="8dp"
        android:max="100" android:progress="0" android:progressTint="#882B4E" android:visibility="gone" />
    <TextView android:id="@+id/txtRotaMDetalhes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:gravity="end" android:padding="4dp" android:text="Detalhes" android:textColor="#4A1B2E" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
