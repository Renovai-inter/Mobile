<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_light_cooperado" android:orientation="vertical">
    <include layout="@layout/include_gestor_header" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView style="@style/G.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lista de funcionários" android:textSize="26sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:background="@drawable/input_field_cooperado_background" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
                <EditText android:id="@+id/edtBusca" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:background="@null"
                    android:hint="Buscar funcionário" android:inputType="textPersonName" android:textColor="#222222" android:textColorHint="#8A8A8A" android:textSize="13sp" />
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_search_dark" android:contentDescription="Buscar" />
            </LinearLayout>
            <TextView android:id="@+id/txtVazio" style="@style/G.Sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="Nenhum funcionário encontrado." android:visibility="gone" />
            <LinearLayout android:id="@+id/secoes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include layout="@layout/include_gestor_nav" />
</LinearLayout>
