<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light_cooperado">

    <LinearLayout
        android:id="@+id/headerListagemTriagens"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/header_cooperado_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtNomeCooperativaHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nome Cooperativa"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/btnPerfilHeader"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/avatar_placeholder_background"
                android:contentDescription="Perfil" />

            <TextView
                android:id="@+id/txtIniciaisCooperado"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="--"
                android:textColor="#D4E699"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linhaContadorTriagens"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerListagemTriagens">

        <TextView
            android:id="@+id/txtContadorTriagens"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 encontradas"
            android:textColor="#222222"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtOrdenarTriagens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mais recentes"
            android:textColor="#519059"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtSemTriagensList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Nenhuma triagem encontrada."
        android:textColor="#8A8A8A"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linhaContadorTriagens" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTriagensList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/linhaContadorTriagens"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationCooperado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationCooperado"
        style="@style/Widget.MaterialComponents.BottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@drawable/menu_background"
        app:itemBackground="@drawable/seletor_menu_background_cooperado"
        app:itemIconSize="20dp"
        app:itemIconTint="@color/seletor_menu_icon_cooperado"
        app:itemPaddingBottom="6dp"
        app:itemPaddingTop="12dp"
        app:itemRippleColor="@android:color/transparent"
        app:itemTextColor="@color/seletor_menu_icon_cooperado"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_cooperado" />

</androidx.constraintlayout.widget.ConstraintLayout>
