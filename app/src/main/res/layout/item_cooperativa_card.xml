<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="140dp" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:background="@drawable/cooperativa_card_background" android:orientation="vertical" android:padding="10dp">
    <ImageView android:id="@+id/imgCooperativa" android:layout_width="match_parent" android:layout_height="80dp" android:background="@drawable/pedido_foto_placeholder" android:scaleType="centerCrop" android:contentDescription="Foto da cooperativa"/>
    <TextView android:id="@+id/txtNome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Nome" android:textColor="#882B4E" android:textSize="14sp" android:textStyle="bold"/>
    <TextView android:id="@+id/txtAvaliacao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="4.2 ★ (27)" android:textColor="#8A8A8A" android:textSize="12sp"/>
</LinearLayout>