<resources xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        As telas foram desenhadas em fundo claro: o tema é sempre claro (no modo escuro do sistema
        os textos ficavam claros sobre fundo claro). As cores da marca substituem o roxo padrão do
        Material 3 em botões, diálogos, cursores, carregamentos e seleções.
    -->
    <style name="Base.Theme.Renovai" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/vinho</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/vinho_claro</item>
        <item name="colorOnPrimaryContainer">@color/vinho</item>
        <item name="colorSecondary">@color/verde</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/verde_claro</item>
        <item name="colorOnSecondaryContainer">#1F4D26</item>
        <item name="colorTertiary">@color/verde</item>
        <item name="colorAccent">@color/vinho</item>
        <item name="android:colorAccent">@color/vinho</item>
        <item name="colorControlActivated">@color/vinho</item>
        <item name="android:textColorHighlight">#55882B4E</item>
        <item name="android:colorBackground">@color/background_light_cooperado</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Renovai.Dialogo</item>
        <!-- Os cabeçalhos são escuros (verde/vinho) e ficam por trás da barra de status: ícones brancos. -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Renovai" parent="Base.Theme.Renovai" />

    <!--
        Só da SplashActivity: a splash do sistema (Android 12+) fica só verde, sem o ícone, e a
        janela já abre verde. Assim a animação do Renovaí começa sem "piscar" outra tela antes.
    -->
    <style name="Theme.Renovai.Splash" parent="Theme.Renovai">
        <item name="android:windowBackground">@color/verde</item>
        <item name="android:windowSplashScreenBackground">@color/verde</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_sistema</item>
    </style>

    <!--
        Pop-up padrão do app (imagem Pop-up-padrao): cartão branco com cantos de 20dp, título em
        negrito no vinho, texto cinza e o botão principal cheio, à direita. Vale para todo
        MaterialAlertDialogBuilder do app.
    -->
    <style name="ThemeOverlay.Renovai.Dialogo" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/vinho</item>
        <item name="colorSurface">@color/white</item>
        <item name="alertDialogStyle">@style/Renovai.Popup</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Renovai.Popup.Titulo</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Renovai.Popup.Texto</item>
        <item name="buttonBarPositiveButtonStyle">@style/Renovai.Popup.BotaoPrincipal</item>
        <item name="buttonBarNegativeButtonStyle">@style/Renovai.Popup.BotaoTexto</item>
        <item name="buttonBarNeutralButtonStyle">@style/Renovai.Popup.BotaoTexto</item>
    </style>

    <style name="Renovai.Popup" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">@color/white</item>
        <item name="shapeAppearance">@style/Renovai.Popup.Forma</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>

    <style name="Renovai.Popup.Forma" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Renovai.Popup.Titulo" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/vinho</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Renovai.Popup.Texto" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/popup_texto</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- Botão principal (Fechar, Salvar, Confirmar...): cheio, vinho rosado, texto branco em negrito. -->
    <style name="Renovai.Popup.BotaoPrincipal" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/popup_botao</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Botões secundários (Cancelar, Desativar...): só o texto, no vinho. -->
    <style name="Renovai.Popup.BotaoTexto" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/vinho</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
