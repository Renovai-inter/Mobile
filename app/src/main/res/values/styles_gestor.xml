<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base necessária para os estilos G.* -->
    <style name="G" />

    <style name="G.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#222222</item>
    </style>

    <style name="G.Sub">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#6B7280</item>
    </style>

    <style name="G.Label">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#8A8A8A</item>
    </style>

    <style name="G.Value">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#4A1B2E</item>
    </style>

    <style name="G.Section">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#222222</item>
    </style>

    <style name="G.Green">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#519059</item>
    </style>

    <style name="G.Card">
        <item name="android:background">@drawable/status_card_cooperado_background</item>
        <item name="android:padding">14dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="G.BtnFilled">
        <item name="android:background">@drawable/filled_button_cooperado_background</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="G.BtnOutline">
        <item name="android:background">@drawable/outline_button_cooperado_background</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">13dp</item>
        <item name="android:textColor">#882B4E</item>
        <item name="android:textSize">14sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="G.BtnGreen">
        <item name="android:background">@drawable/btn_green_background</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="G.Track">
        <item name="android:background">@drawable/toggle_track_cooperado_background</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="G.Input">
        <item name="android:background">@drawable/input_field_cooperado_background</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textColorHint">#AAAAAA</item>
    </style>

</resources>