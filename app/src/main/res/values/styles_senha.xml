<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Caixinha de um dígito do código de redefinição de senha (activity_codigo_senha.xml) -->
    <style name="CodigoDigito">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:background">@drawable/codigo_digito_background</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:cursorVisible">false</item>
    </style>

</resources>
