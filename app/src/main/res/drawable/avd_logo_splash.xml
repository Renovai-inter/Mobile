<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_logo">
    <!-- Linha do tempo igual à prévia (ms): cabeça 0, nariz 420, orelhas 520/580, rabo 300, gomos 300+90·i, piscadas 1450 e 2580. -->
    <target android:name="cabeca">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="520" android:startOffset="0" android:interpolator="@interpolator/splash_overshoot"/>
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="520" android:startOffset="0" android:interpolator="@interpolator/splash_overshoot"/>
            </set>
        </aapt:attr>
    </target>
    <target android:name="nariz">
        <aapt:attr name="android:animation">
            <set>
            <objectAnimator android:duration="400" android:startOffset="420">
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1"/>
                    <keyframe android:fraction="0.35" android:value="1.45"/>
                    <keyframe android:fraction="1" android:value="1"/>
                </propertyValuesHolder>
            </objectAnimator>
            <objectAnimator android:duration="400" android:startOffset="420">
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1"/>
                    <keyframe android:fraction="0.35" android:value="1.45"/>
                    <keyframe android:fraction="1" android:value="1"/>
                </propertyValuesHolder>
            </objectAnimator>
            </set>
        </aapt:attr>
    </target>
    <target android:name="orelhaD">
