                    <keyframe android:fraction="0.28" android:value="14"/>
                    <keyframe android:fraction="0.6" android:value="-8"/>
                    <keyframe android:fraction="1" android:value="0"/>
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
